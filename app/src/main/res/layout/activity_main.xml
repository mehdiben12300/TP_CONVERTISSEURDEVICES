<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/keypad_bg"
    tools:context=".MainActivity">

    <!-- Zone du haut (environ 45% de l'écran sur fond bleu turquoise uni #2BB8E8) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topZone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/turquoise_top_bg"
        android:padding="16dp"
        app:layout_constraintHeight_percent="0.48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Titre : tvTitre -->
        <TextView
            android:id="@+id/tvTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_currency_converter"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Ligne 1 : Spinner Source + Montant -->
        <Spinner
            android:id="@+id/spDeviseSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:spinnerMode="dropdown"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitre" />

        <TextView
            android:id="@+id/tvMontant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_underline"
            android:gravity="end"
            android:maxLines="1"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="44sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/spDeviseSource"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/spDeviseSource"
            app:layout_constraintTop_toTopOf="@id/spDeviseSource" />

        <!-- Bouton Inverser : btnInverser -->
        <ImageButton
            android:id="@+id/btnInverser"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginVertical="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_swap"
            android:padding="8dp"
            android:src="@drawable/ic_swap"
            app:layout_constraintBottom_toTopOf="@id/spDeviseCible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spDeviseSource" />

        <!-- Ligne 2 : Spinner Cible + Résultat -->
        <Spinner
            android:id="@+id/spDeviseCible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:spinnerMode="dropdown"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnInverser" />

        <TextView
            android:id="@+id/tvResultat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_underline"
            android:gravity="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/white"
            android:textSize="44sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/spDeviseCible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/spDeviseCible"
            app:layout_constraintTop_toTopOf="@id/spDeviseCible" />

        <!-- Bouton Convertir : btnConvertir -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConvertir"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_convert"
            android:textColor="@color/turquoise_keypad_text"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/white"
            app:cornerRadius="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvResultat" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Zone du bas : Clavier numérique TableLayout 4x3 -->
    <TableLayout
        android:id="@+id/tableLayoutKeypad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        android:stretchColumns="*"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topZone">

        <!-- Ligne 1 : 7, 8, 9 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <Button
                android:id="@+id/btn7"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/digit_7"
                android:textColor="@color/turquoise_keypad_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn8"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/digit_8"
                android:textColor="@color/turquoise_keypad_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn9"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/digit_9"
                android:textColor="@color/turquoise_keypad_text"
                android:textSize="32sp"
                android:textStyle="bold" />
        </TableRow>

        <!-- Ligne 2 : 4, 5, 6 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <Button
                android:id="@+id/btn4"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/digit_4"
                android:textColor="@color/turquoise_keypad_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn5"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/digit_5"
                android:textColor="@color/turquoise_keypad_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn6"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/digit_6"
                android:textColor="@color/turquoise_keypad_text"
                android:textSize="32sp"
                android:textStyle="bold" />
        </TableRow>

        <!-- Ligne 3 : 1, 2, 3 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <Button
                android:id="@+id/btn1"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/digit_1"
                android:textColor="@color/turquoise_keypad_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn2"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/digit_2"
                android:textColor="@color/turquoise_keypad_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn3"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/digit_3"
                android:textColor="@color/turquoise_keypad_text"
                android:textSize="32sp"
                android:textStyle="bold" />
        </TableRow>

        <!-- Ligne 4 : C (rouge), 0, . -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <Button
                android:id="@+id/btnC"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/key_clear"
                android:textColor="@color/red_clear_button"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn0"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/digit_0"
                android:textColor="@color/turquoise_keypad_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDot"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/key_dot"
                android:textColor="@color/turquoise_keypad_text"
                android:textSize="32sp"
                android:textStyle="bold" />
        </TableRow>

    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>